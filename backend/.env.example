# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/sinusa_db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-here-make-it-long-and-random"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=3000
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,http://localhost:3001"

# Twilio Configuration (for SMS OTP)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Redis Configuration (for caching)
REDIS_URL="redis://localhost:6379"

# File Upload Configuration
MAX_FILE_SIZE=10485760 # 10MB in bytes
UPLOAD_PATH="./uploads"

# Payment Gateway Configuration
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_MERCHANT_ID="your-midtrans-merchant-id"
MIDTRANS_IS_PRODUCTION=false

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-email-password"
SMTP_FROM="SiNusa <noreply@sinusa.com>"

# Cloud Storage Configuration (for file uploads)
CLOUD_STORAGE_PROVIDER="local" # local, aws, gcp, azure
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="sinusa-uploads"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL="info"
LOG_FILE_PATH="./logs"

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET="your-session-secret-key"
COOKIE_SECRET="your-cookie-secret-key"

# API Configuration
API_VERSION="v1"
API_PREFIX="/api"

# Default Admin Configuration
DEFAULT_ADMIN_EMAIL="admin@sinusa.com"
DEFAULT_ADMIN_PHONE="+6281234567890"
DEFAULT_ADMIN_PASSWORD="admin123456"

# Notification Configuration
PUSH_NOTIFICATION_ENABLED=false
FCM_SERVER_KEY="your-fcm-server-key"

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Monitoring Configuration
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=false
PROMETHEUS_PORT=9090